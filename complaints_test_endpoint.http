### ==================== Complaints ====================

### Get all complaints
GET http://localhost:9999/pick-location/api/v1/complaints/all
Accept: application/json

### Get complaint by ID
GET http://localhost:9999/pick-location/api/v1/complaints/1
Accept: application/json

### Get complaints by neighborhood
GET http://localhost:9999/pick-location/api/v1/complaints/neighborhood/الحي الأول
Accept: application/json

### Get complaints by status
GET http://localhost:9999/pick-location/api/v1/complaints/status/مفتوح
Accept: application/json

### Get complaints by current user
GET http://localhost:9999/pick-location/api/v1/complaints/user/ahmed
Accept: application/json

### Get complaints by isFinished (not finished)
GET http://localhost:9999/pick-location/api/v1/complaints/finished/0
Accept: application/json

### Get complaints by isFinished (finished)
GET http://localhost:9999/pick-location/api/v1/complaints/finished/1
Accept: application/json

### Get complaints by complaint type
GET http://localhost:9999/pick-location/api/v1/complaints/complaint-type/شكوى مياه
Accept: application/json

### Get complaints by sector name
GET http://localhost:9999/pick-location/api/v1/complaints/sector-name/حي الملك فهد
Accept: application/json

### Create complaint
POST http://localhost:9999/pick-location/api/v1/complaints/create
Content-Type: application/json

{
    "neighborhood": "العجمي",
    "repeatComplaintNumber": 0,
    "complaintSource": "هاتف",
    "reporterName": "محمد",
    "reporterPhone": "0500000000",
    "complaintAddress": "شارع الملك فهد",
    "complaintRepairStatus": "يلزم استخراج تصريح",
    "approvalAuthority": "السكرتير العام المساعد",
    "pumpDiameter": "4 بوصة",
    "seriousStatus": "مستقر",
    "complaintStatus": "عادى",
    "complaintNote": "تم الاصلاح",
    "recipientDestination": "قسم الكهرباء",
    "recipientUser": "محمد",
    "reportNumber": 12344,
    "recipientName": "خالد",
    "gisLink": "http://196.219.231.3:8000/lab-api/lab-marker/430",
    "longitude": "46.6753",
    "latitude": "24.7136",
    "isDeleted": 0,
    "isFinished": 0,
    "isTracked": 0,
    "currentUsername": "ahmed",
    "complaintType": "كسر",
    "sectorName": "تكنولوجيا معلومات",
    "urgencyNumber": 0
}

