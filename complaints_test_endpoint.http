### ==================== Complaints ====================

### Get all complaints
GET http://localhost:9999/pick-location/api/v1/complaints/all
Accept: application/json

### Get complaint by ID
GET http://localhost:9999/pick-location/api/v1/complaints/1
Accept: application/json

### Get complaints by neighborhood
GET http://localhost:9999/pick-location/api/v1/complaints/neighborhood/الحي الأول
Accept: application/json

### Get complaints by status
GET http://localhost:9999/pick-location/api/v1/complaints/status/مفتوح
Accept: application/json

### Get complaints by current user
GET http://localhost:9999/pick-location/api/v1/complaints/user/ahmed
Accept: application/json

### Create complaint
POST http://localhost:9999/pick-location/api/v1/complaints/create
Content-Type: application/json

{
  "complaintAddress": "شارع الملك فهد",
  "currentUsername": "ahmed",
  "neighborhood": "الحي الأول",
  "reporterName": "محمد",
  "reporterPhone": "0500000000",
  "complaintSource": "هاتف",
  "complaintStatus": "مفتوح",
  "complaintRepairStatus": "قيد التنفيذ",
  "approvalAuthority": "إدارة المشتريات",
  "pumpDiameter": "4 بوصة",
  "seriousStatus": "عالي",
  "complaintNote": "شكوى عاجلة",
  "recipientDestination": "قسم الصيانة",
  "recipientUser": "علي",
  "recipientName": "خالد",
  "gisLink": "https://gis.example.com/1",
  "longitude": "46.6753",
  "latitude": "24.7136"
}

### Update complaint
PUT http://localhost:9999/pick-location/api/v1/complaints/1
Content-Type: application/json

{
  "complaintAddress": "شارع الملك فهد",
  "currentUsername": "ahmed",
  "neighborhood": "الحي الثاني",
  "reporterName": "محمد",
  "reporterPhone": "0500000000",
  "complaintSource": "هاتف",
  "complaintStatus": "مغلق",
  "complaintRepairStatus": "تم الاصلاح",
  "approvalAuthority": "إدارة المشتريات",
  "pumpDiameter": "4 بوصة",
  "seriousStatus": "منخفض",
  "complaintNote": "تم الاصلاح",
  "recipientDestination": "قسم الصيانة",
  "recipientUser": "علي",
  "recipientName": "خالد",
  "gisLink": "https://gis.example.com/1",
  "longitude": "46.6753",
  "latitude": "24.7136"
}

### Update repeat complaint number
PUT http://localhost:9999/pick-location/api/v1/complaints/1/repeat-complaint-number
Content-Type: application/json

{
  "repeatComplaintNumber": 2
}

### Update recipient destination and user
PUT http://localhost:9999/pick-location/api/v1/complaints/1/recipient
Content-Type: application/json

{
  "recipientDestination": "قسم الكهرباء",
  "recipientUser": "محمد"
}

### Update tracked status
PUT http://localhost:9999/pick-location/api/v1/complaints/1/tracked
Content-Type: application/json

{
  "isTracked": 1
}

### Finish complaint
PUT http://localhost:9999/pick-location/api/v1/complaints/1/finish
Content-Type: application/json

### Soft-delete complaint
PUT http://localhost:9999/pick-location/api/v1/complaints/1/delete
Content-Type: application/json

### Hard-delete complaint
DELETE http://localhost:9999/pick-location/api/v1/complaints/1
